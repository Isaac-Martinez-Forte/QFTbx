# Doxygen configuration for QFTbx.
#
# Written by hand rather than dumped from `doxygen -g`: everything not
# named here keeps its Doxygen default, so this file says only what QFTbx
# actually decides, and a reader can see all of it at once.
#
#   doxygen                     from the repository root
#   cmake --build build --target docs
#
# The output lands in docs/api/html/index.html and is not committed.

#---------------------------------------------------------------------------
# The project
#---------------------------------------------------------------------------

PROJECT_NAME           = QFTbx
PROJECT_BRIEF          = "Robust control design with Quantitative Feedback Theory"

# The application icon in the header bar of every page, and where the
# images referenced from the documentation are looked up. The banner lives
# in docs/ rather than with the icons because it is a documentation asset
# the application never loads - and because that is the one place where
# both resolvers agree on the same path: GitHub reads it relative to the
# markdown file, and doxygen copies it out of IMAGE_PATH. A path with a
# "../" in it satisfies GitHub and leaves a broken image in the generated
# HTML, which is how this ended up here.
PROJECT_LOGO           = Resources/Icon/qftbx_64.png
IMAGE_PATH             = docs Resources/Icon
OUTPUT_DIRECTORY       = docs/api
OUTPUT_LANGUAGE        = English

# Paths in the docs read as they do in the repository (src/core/..., not
# /home/somebody/workspace/QFTbx/src/core/...).
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .

#---------------------------------------------------------------------------
# What to read
#---------------------------------------------------------------------------

# The architecture note comes first so it becomes the landing page: it
# already explains the QFT pipeline and the module layout, and one
# description of those is enough.
INPUT                  = docs/ARCHITECTURE.md \
                         src \
                         GUI
USE_MDFILE_AS_MAINPAGE = docs/ARCHITECTURE.md

FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES

# Vendored libraries are documented by their own authors, and everything
# under build/ is either generated by Qt (moc_, ui_, qrc_, *_autogen) or a
# copy of a dependency's sources.
EXCLUDE                = 3rd-party \
                         build
EXCLUDE_PATTERNS       = */build*/* \
                         */_deps/* \
                         moc_*.cpp \
                         ui_*.h \
                         qrc_*.cpp \
                         *_autogen/*

#---------------------------------------------------------------------------
# What to extract
#---------------------------------------------------------------------------

# YES because the docs double as a browsable reference of the whole API:
# the documentation policy is deliberately to explain the algorithms and
# the API and to leave trivial accessors alone, so those show up as bare
# signatures - which is the honest picture and better than hiding them.
EXTRACT_ALL            = YES

# The private members of the algorithms carry their reasoning in the
# implementation, next to the code; the source browser below is where to
# read that, not the class reference.
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

# The codebase documents with `///` one-liners far more often than with an
# explicit \brief, and these two make the first sentence of those the
# brief, which is what the author meant.
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES

TAB_SIZE               = 4
BUILTIN_STL_SUPPORT    = YES

# Alphabetical members, declaration-ordered detail: the header's own order
# is usually the order the author wanted to be read in.
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = YES

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------

QUIET                  = YES
WARNINGS               = YES

# NO on purpose. The policy leaves trivial internals undocumented, so this
# would produce hundreds of warnings about accessors nobody intends to
# document and bury the ones that matter.
WARN_IF_UNDOCUMENTED   = NO

# These three are the ones that matter: a \param naming an argument that
# does not exist, a half-documented signature, a broken reference. They
# are documentation bugs, and they fail the build.
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

#---------------------------------------------------------------------------
# HTML
#---------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_DYNAMIC_SECTIONS  = YES
HTML_COLORSTYLE        = TOGGLE
SEARCHENGINE           = YES

#---------------------------------------------------------------------------
# The source browser
#---------------------------------------------------------------------------

# Much of the reasoning in this codebase lives in ordinary `//` comments
# beside the code - why a rounding mode is set here, why this identity
# guard became wrong under ownership transfer, which line of a paper a
# formula comes from. STRIP_CODE_COMMENTS = NO is what keeps all of that
# readable in the generated sources instead of throwing it away.
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = NO
VERBATIM_HEADERS       = YES

#---------------------------------------------------------------------------
# Formulas
#---------------------------------------------------------------------------

# The algorithm headers are full of \f$ ... \f$: interval enclosures,
# boundary conditions, the loop transmission. MathJax renders them in the
# browser, which is the only option here because there is no LaTeX
# installed to bake them into images. It does mean the pages need internet
# for the formulas (the rest of the docs work offline); to make them fully
# offline, drop a MathJax copy somewhere and point MATHJAX_RELPATH at it.
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
MATHJAX_RELPATH        = https://cdn.jsdelivr.net/npm/mathjax@3

#---------------------------------------------------------------------------
# Diagrams
#---------------------------------------------------------------------------

# Graphviz is used for the inheritance and include graphs. The call graphs
# are off: on a branch & bound whose helpers call each other in loops they
# come out as unreadable hairballs.
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_GRAPH_MAX_NODES    = 60
