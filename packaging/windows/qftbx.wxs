<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="QFTbx" Language="1033" Codepage="1252" Version="$(var.Version)"
           Manufacturer="Isaac Martínez Forte, Joaquín Cervera López"
           UpgradeCode="5AC59924-D793-4B08-811C-26A133D145BF">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             SummaryCodepage="1252" Description="QFTbx $(var.Version) beta, quantitative feedback theory toolbox" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of QFTbx is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="qftbx.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="qftbx.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Isaac-Martinez-Forte/QFTbx" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="QFTbx" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="CD4731BC-9D80-41A0-8E69-B2C9A50A0E08" Win64="yes">
        <Shortcut Id="QFTbxShortcut" Name="QFTbx" Description="Quantitative feedback theory toolbox"
                  Target="[INSTALLFOLDER]QFTbx.exe" WorkingDirectory="INSTALLFOLDER" Icon="qftbx.ico" />
        <RegistryValue Root="HKCU" Key="Software\QFTbx" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="QFTbx" Level="1">
      <ComponentGroupRef Id="QFTbxFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
  </Product>
</Wix>
