<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SpecificationsForm</class>
 <widget class="QWidget" name="SpecificationsForm">
  <property name="windowTitle">
   <string>Specifications</string>
  </property>
  <!-- The form and the list of what has been entered stand side by side, so
       this phase is worth two squares of the canvas: the card reads this to
       decide, until the user says otherwise with its own buttons. -->
  <property name="minimumSize">
   <size><width>700</width><height>0</height></size>
  </property>
  <layout class="QVBoxLayout" name="formLayout">
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>
   <item>
    <layout class="QHBoxLayout" name="bodyLayout">
     <item>
      <layout class="QVBoxLayout" name="entryLayout">
       <item>
        <layout class="QFormLayout" name="headLayout">
         <item row="0" column="0">
          <widget class="QLabel" name="typeLabel">
           <property name="text"><string>Specification:</string></property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QComboBox" name="typeCombo">
           <property name="toolTip">
             <string>Which of the seven requirements this is. Each one bounds a different closed-loop magnitude, and the formula below says which.</string>
            </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="bandLabel">
           <property name="text"><string>Applies at:</string></property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QWidget" name="frequencyHolder" native="true">
           <layout class="QVBoxLayout" name="frequencyLayout">
            <property name="leftMargin"><number>0</number></property>
            <property name="topMargin"><number>0</number></property>
            <property name="rightMargin"><number>0</number></property>
            <property name="bottomMargin"><number>0</number></property>
           </layout>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="boundLabel">
           <property name="text"><string>Bound:</string></property>
          </widget>
         </item>
         <item row="2" column="1">
          <layout class="QHBoxLayout" name="boundRow">
           <item>
            <widget class="QRadioButton" name="constantRadio">
             <property name="toolTip">
               <string>One magnitude for the whole band.</string>
              </property>
             <property name="text"><string>A constant</string></property>
             <attribute name="buttonGroup"><string notr="true">boundKind</string></attribute>
            </widget>
           </item>
           <item>
            <widget class="QRadioButton" name="systemRadio">
             <property name="toolTip">
               <string>A transfer function, evaluated at each frequency of the band.</string>
              </property>
             <property name="text"><string>A transfer function</string></property>
             <attribute name="buttonGroup"><string notr="true">boundKind</string></attribute>
            </widget>
           </item>
           <item>
            <spacer name="boundSpacer">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0">
              <size><width>0</width><height>0</height></size>
             </property>
            </spacer>
           </item>
          </layout>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QStackedWidget" name="boundStack">
         <property name="currentIndex"><number>0</number></property>
         <widget class="QWidget" name="constantPage">
          <layout class="QFormLayout" name="constantLayout">
           <property name="leftMargin"><number>0</number></property>
           <property name="topMargin"><number>0</number></property>
           <property name="rightMargin"><number>0</number></property>
           <property name="bottomMargin"><number>0</number></property>
           <item row="0" column="0">
            <widget class="QLabel" name="magnitudeLabel">
             <property name="text"><string>Magnitude:</string></property>
            </widget>
           </item>
           <item row="0" column="1">
            <layout class="QHBoxLayout" name="magnitudeRow">
             <item>
              <widget class="QLineEdit" name="magnitudeEdit">
               <property name="toolTip">
                 <string>The bound itself.</string>
                </property>
              </widget>
             </item>
             <item>
              <widget class="QRadioButton" name="decibelsRadio">
               <property name="toolTip">
                 <string>The magnitude above is in decibels.</string>
                </property>
               <property name="text"><string>dB</string></property>
               <attribute name="buttonGroup"><string notr="true">magnitudeUnits</string></attribute>
              </widget>
             </item>
             <item>
              <widget class="QRadioButton" name="linearRadio">
               <property name="toolTip">
                 <string>It is a linear magnitude, where 1 is 0 dB.</string>
                </property>
               <property name="text"><string>linear</string></property>
               <attribute name="buttonGroup"><string notr="true">magnitudeUnits</string></attribute>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
         <widget class="QWidget" name="systemPage">
          <layout class="QVBoxLayout" name="systemPageLayout">
           <property name="leftMargin"><number>0</number></property>
           <property name="topMargin"><number>0</number></property>
           <property name="rightMargin"><number>0</number></property>
           <property name="bottomMargin"><number>0</number></property>
           <item>
            <layout class="QHBoxLayout" name="familyRow">
             <item>
              <widget class="QRadioButton" name="polynomialRadio">
               <property name="toolTip">
                 <string>The bound is given by the coefficients of its two polynomials, by descending power.</string>
                </property>
               <property name="text"><string>Polynomial</string></property>
               <attribute name="buttonGroup"><string notr="true">boundFamily</string></attribute>
              </widget>
             </item>
             <item>
              <widget class="QRadioButton" name="zpkRadio">
               <property name="toolTip">
                 <string>By its zeros and poles, as factors (s + a).</string>
                </property>
               <property name="text"><string>Zeros and poles</string></property>
               <attribute name="buttonGroup"><string notr="true">boundFamily</string></attribute>
              </widget>
             </item>
             <item>
              <widget class="QRadioButton" name="tcgRadio">
               <property name="toolTip">
                 <string>By its time constants, as factors (1 + s/T).</string>
                </property>
               <property name="text"><string>Time constants</string></property>
               <attribute name="buttonGroup"><string notr="true">boundFamily</string></attribute>
              </widget>
             </item>
             <item>
              <widget class="QRadioButton" name="freeFormRadio">
               <property name="toolTip">
                 <string>By an expression in s.</string>
                </property>
               <property name="text"><string>Free form</string></property>
               <attribute name="buttonGroup"><string notr="true">boundFamily</string></attribute>
              </widget>
             </item>
             <item>
              <spacer name="familySpacer">
               <property name="orientation"><enum>Qt::Horizontal</enum></property>
               <property name="sizeHint" stdset="0">
                <size><width>0</width><height>0</height></size>
               </property>
              </spacer>
             </item>
            </layout>
           </item>
           <item>
            <layout class="QFormLayout" name="systemFields">
             <item row="0" column="0">
              <widget class="QLabel" name="numeratorLabel">
               <property name="text"><string>Numerator:</string></property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QLineEdit" name="numeratorEdit">
               <property name="toolTip">
                 <string>Separated by spaces, in the form the family above asks for.</string>
                </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="denominatorLabel">
               <property name="text"><string>Denominator:</string></property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QLineEdit" name="denominatorEdit">
               <property name="toolTip">
                 <string>Separated by spaces, in the form the family above asks for.</string>
                </property>
              </widget>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="gainLabel">
               <property name="text"><string>Gain:</string></property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QLineEdit" name="k">
               <property name="toolTip">
                 <string>The gain of the bound.</string>
                </property>
              </widget>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="delayLabel">
               <property name="text"><string>Delay:</string></property>
              </widget>
             </item>
             <item row="3" column="1">
              <widget class="QLineEdit" name="delayEdit">
               <property name="toolTip">
                 <string>Its delay in seconds; zero if it has none.</string>
                </property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </widget>
       </item>
       <item>
        <spacer name="entrySpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0">
          <size><width>0</width><height>0</height></size>
         </property>
        </spacer>
       </item>
       <item>
        <widget class="qftbx::FormulaView" name="boundFormula" native="true">
         <property name="minimumSize">
          <size><width>0</width><height>60</height></size>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="entryButtons">
         <item>
          <widget class="QLabel" name="statusLabel">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
             <horstretch>1</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="text"><string/></property>
           <property name="wordWrap"><bool>true</bool></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="clearButton">
           <property name="toolTip">
             <string>Empties the fields, ready for the next specification.</string>
            </property>
           <property name="text"><string>Clear</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="addButton">
           <property name="toolTip">
             <string>Reads the specification and draws it. Pressing it again puts it on the list.</string>
            </property>
           <property name="text"><string>Verify</string></property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </item>
     <item>
      <layout class="QVBoxLayout" name="listLayout">
       <item>
        <widget class="QLabel" name="listLabel">
         <property name="text"><string>Specifications of the design</string></property>
        </widget>
       </item>
       <item>
        <widget class="QTableWidget" name="specificationsTable">
         <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
         <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
         <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
         <property name="alternatingRowColors"><bool>true</bool></property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="listButtons">
         <item>
          <spacer name="listSpacer">
           <property name="orientation"><enum>Qt::Horizontal</enum></property>
           <property name="sizeHint" stdset="0">
            <size><width>0</width><height>0</height></size>
           </property>
          </spacer>
         </item>
         <item>
          <widget class="QPushButton" name="editButton">
           <property name="toolTip">
             <string>Brings the specification chosen in the list back into the form.</string>
            </property>
           <property name="text"><string>Edit</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="removeButton">
           <property name="toolTip">
             <string>Takes the specification chosen in the list out of the design.</string>
            </property>
           <property name="text"><string>Remove</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="okButton">
           <property name="toolTip">
             <string>Applies the list. The boundaries are computed from it.</string>
            </property>
           <property name="text"><string>Apply</string></property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
