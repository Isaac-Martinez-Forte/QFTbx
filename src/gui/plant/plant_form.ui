           <item>
            <widget class="QRadioButton" name="zerosPolesRadio">
             <property name="toolTip">
               <string>Written as its roots: one factor (s + a) per zero and per pole.</string>
              </property>
             <property name="text"><string>Zeros &amp;and poles</string></property>
             <attribute name="buttonGroup"><string notr="true">secondLevel</string></attribute>
            </widget>
           </item>
           <item>
            <widget class="QRadioButton" name="polynomialRadio">
