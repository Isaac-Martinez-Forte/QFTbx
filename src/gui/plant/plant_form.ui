               <string>The gain multiplies the factors (s + a), so it is the gain at high frequency.</string>
              </property>
             <property name="text"><string>&amp;k = hfgain</string></property>
             <attribute name="buttonGroup"><string notr="true">thirdLevel</string></attribute>
            </widget>
           </item>
           <item>
            <widget class="QRadioButton" name="tcgRadio">
             <property name="toolTip">
