            <widget class="QRadioButton" name="freeFormRadio">
             <property name="toolTip">
               <string>An expression in s, whatever it is: a delay, a root, anything the grammar of the toolbox reads. Every name in it that is not s is an uncertain parameter.</string>
              </property>
             <property name="text"><string>Free form</string></property>
             <attribute name="buttonGroup"><string notr="true">firstLevel</string></attribute>
            </widget>
           </item>
          </layout>
