   <item>
    <widget class="QCheckBox" name="wholeTemplateCheck">
     <property name="toolTip">
      <string>Where the contour walk does not close with the epsilon given, use the whole template as its contour at that frequency: always safe, only slower, and marked in the viewer. Unchecked, the computation stops and names the frequency instead.</string>
     </property>
     <property name="text">
      <string>Use the whole template where the contour does not close</string>
     </property>
     <property name="checked">
      <bool>true</bool>
