   <item>
    <layout class="QVBoxLayout" name="sideLayout">
     <item>
      <widget class="QPushButton" name="templatesButton">
       <property name="toolTip">
         <string>Shows or hides the templates themselves, behind their contours.</string>
        </property>
       <property name="text"><string>Show templates</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="contourButton">
