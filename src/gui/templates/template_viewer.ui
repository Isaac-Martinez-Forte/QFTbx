       <property name="text"><string>Hide contour</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="recomputeButton">
       <property name="toolTip">
         <string>Walks the contours again with the epsilon each frequency has in the list.</string>
        </property>
       <property name="text"><string>Recompute</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="proposeButton">
       <property name="toolTip">
        <string>Set every epsilon to the least value at which the contour of its template closes, and recompute the contours.</string>
       </property>
       <property name="text"><string>Propose epsilon</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="saveImage">
       <property name="toolTip">
         <string>Writes the diagram to an image file.</string>
        </property>
       <property name="text"><string>Save the diagram</string></property>
