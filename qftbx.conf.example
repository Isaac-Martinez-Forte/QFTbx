# QFTbx settings. Every key has a compiled default and this file only says
# what to change: a key left out keeps its default. Copy it as qftbx.conf and
# uncomment what you change. The reference is docs/CONFIGURATION.md.
#
# Read from the first of these that exists: the file named by QFTBX_CONFIG
# (naming a file that cannot be read is an error), ./qftbx.conf, and
# $HOME/.config/qftbx/qftbx.conf.
#
# Comments start with # or ; and run to the end of the line. A key is its
# section and its name: max-grid-cells under [limits] is limits.max-grid-cells.
# A value that is not a number, or lies outside the range stated below, stops
# the program with a message naming the key and the line.


# [interface] - the interface. The window writes canvas and window itself,
# and the View menu writes language and theme.
[interface]

# The language the interface starts in: "system", or a compiled translation
# ("en", "es"; the View menu lists them).
# language = system

# "system" takes the machine's colours, "light" and "dark" the toolbox's own.
# theme = system

# Significant digits the forms show. The project file keeps every digit.
# Range: 1 to 17.
# digits = 4

# The canvas as it was left when the application closed: a "phase:size" list.
# canvas =

# The window size when it closed: "width height", "maximized", or empty.
# window =


# [log] - the record of what the engines did and how long it took, one line
# per stage.
[log]

# Off by default.
# enabled = 0

# Empty means $XDG_STATE_HOME/qftbx/qftbx.log, or
# $HOME/.local/state/qftbx/qftbx.log. A path that cannot be written leaves
# the record closed rather than stopping a computation.
# path =

# Past this size the file becomes the previous generation and a new one
# starts; two generations are kept.
# Range: 16 to 1048576.
# size-limit-kilobytes = 1024


# [limits] - ceilings against typos. They only refuse input; none changes a
# computed result.
[limits]

# Cells of the Nichols grid of the boundaries, phase points x magnitude
# points (the one-degree grid is 130321).
# Range: 4 to 1e15.
# max-grid-cells = 10000000

# Points per parameter grid in the template sweep.
# Range: 1 to 1e12.
# max-template-points = 1000000

# Design frequencies in one set.
# Range: 1 to 2147483647.
# max-frequency-count = 1000000

# Largest magnitude the loop-shaping dialog accepts.
# Range: 1 to 1e300.
# max-magnitude = 1e12


# [search] - what the interval search may spend.
[search]

# Live nodes the branch and bound list may hold before it refuses to grow. A
# memory budget: 528 bytes per node with two uncertain parameters, 1056 with
# eight, so the default is 17 to 34 GB. Every run prints its peak live nodes.
# Range: 1 to 1e15.
# max-live-nodes = 32000000


# [defaults.*] - what the dialogs are prefilled with. Nothing here changes a
# result: the value is on screen and can be typed over.

# The Nichols grid of the boundary computation: phase in degrees, magnitude
# in decibels, points per axis. The phase axis must span at least 360 degrees.
# Ranges: phase ends -3600 to 3600, magnitude ends -1000 to 1000, points 2
# to 1e6.
[defaults.boundary-grid]
# phase-start = -360
# phase-end = 0
# phase-points = 361
# magnitude-start = -60
# magnitude-end = 60
# magnitude-points = 121

# Read the whole template cloud for the boundaries instead of its contour:
# always safe, more conservative, and the cure when a contour comes out wrong.
# Range: 0 or 1.
# from-cloud = 0

[defaults.templates]
# Points per parameter grid in the template sweep. With n uncertain
# parameters the sweep evaluates this many to the power of n plants.
# Range: 1 to 1e6.
# point-count = 25

# The plane a new project measures its contour epsilon in: 1 the Nichols
# plane (degrees and decibels), 0 the complex plane (the historical reading).
# Range: 0 or 1.
# epsilon-in-nichols = 1

# Decibels that weigh as much as one degree in the Nichols plane.
# Range: 1e-6 to 1e6.
# db-per-degree = 1

# The frequency range the loop-shaping plot starts with, in rad/s, and the
# points over it.
# Ranges: ends 1e-300 to 1e300, points 2 to 1e6.
[defaults.loop-shaping]
# start = 1e-09
# end = 10
# point-count = 100


# [stability] - the frequency grid of the nominal stability check. Coarser
# is faster and may answer "cannot decide"; the criterion is not a setting.
[stability]

# Points of the base logarithmic grid.
# Range: 10 to 1e7.
# base-grid-points = 3000

# Decades sampled beyond the design frequencies, on both sides.
# Range: 0 to 20.
# decades-beyond = 3

# Phase step, in degrees, above which the grid is refined: the unwrapping
# tolerance.
# Range: 0.1 to 180.
# max-phase-step-degrees = 30

# Refinements one verdict may spend before answering "cannot decide".
# Range: 1 to 1e9.
# refinement-budget = 200000


# [algorithms] - figures from the published algorithms. These change what an
# algorithm computes, not only how long it takes: with a value changed here
# the program is no longer the one the golden tests and the article
# validations describe.
[algorithms]

# MR (Rambabu and Nataraj, FDA-10): template points entering the constraint
# set per design frequency. The paper uses 9; raising it does not close the
# tracking gap the sampling leaves.
# Range: 2 to 1000.
# template-representatives = 9

# MR: passes of the HC4 narrowing before a box is accepted as narrowed.
# Range: 1 to 1000.
# max-narrowing-passes = 8

# MR: what the termination epsilon measures. 0, the paper's: the width of
# the controller parameter box. 1: the Nichols box of the leading node, as
# the other four algorithms do (needs a zero-pole-gain controller).
# Range: 0 or 1.
# mr-nichols-epsilon = 0

# Templates: when the contour walk does not close at a frequency, 1 lets the
# whole template stand in for its contour there; 0 stops with an error.
# Range: 0 or 1.
# whole-template-if-no-contour = 1

# Templates: 0 extracts the contour by Nordin's walk, the published
# epsilon-hull; 1 by the alpha-shape, which always closes and returns every
# component and hole.
# Range: 0 or 1.
# alpha-shape-contour = 0

# Templates: with exactly two uncertain parameters, 1 sweeps only the border
# of the parameter box, where the worst case of every specification lies.
# Range: 0 or 1.
# border-sweep = 0

# Boundaries: 1 reads the columns of the five magnitude specifications in
# closed form (Chait and Yaniv 1993), exact in magnitude and multivalued
# where they are; 0 reads them off the sampled sheet. Tracking keeps its
# sheet.
# Range: 0 or 1.
# closed-form-columns = 0

# NK (Nataraj and Kubal 2007): iterations the local refinement of a
# candidate may spend.
# Range: 1 to 1e7.
# local-search-budget = 400

# NK: the ratio at which the gain bisection stops, 1.01 being one per cent.
# A pruning bound, not the accuracy of the answer.
# Range: above 1, up to 10.
# gain-tolerance = 1.01

# MC1 (Martinez-Forte and Cervera, IJRNC 2021): the same ratio for the
# certified gain search.
# Range: above 1, up to 10.
# certified-gain-tolerance = 1.01
