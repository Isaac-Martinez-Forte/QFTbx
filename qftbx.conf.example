# QFTbx settings.
#
# Every value here has a compiled default, and this file only says what to
# CHANGE: a key you leave out keeps its default, and with no settings file at
# all the program runs exactly as it does today. Nothing in here is required.
#
# Where it is looked for, first one that exists wins:
#
#   1. the path in the QFTBX_CONFIG environment variable  (naming a file that
#      cannot be read IS an error - naming it says you meant it)
#   2. ./qftbx.conf, next to wherever the program was started
#   3. $HOME/.config/qftbx/qftbx.conf
#
# Comments start with # or ; and run to the end of the line. Sections group
# the keys, and a key is its whole path: max-grid-cells under [limits] is
# limits.max-grid-cells, and the same name under another section is a
# different setting.
#
# A value that is not a number is REFUSED, naming the key and the line. It
# does not quietly become zero: every setting below states its range, and a
# value outside it stops the program with a message rather than running with
# something you did not intend.
#
# What is NOT here, and will not be: 2*pi, the two layers of the boundary
# union, the seven specification slots, the 0 dB ray of the stability
# criterion. Those can be written in a file, and writing them would not
# configure anything - it would break the program. A setting is a value with
# a defensible range.


# ---------------------------------------------------------------------------
# [interface] - the interface, and the one setting here that is a text.
# ---------------------------------------------------------------------------
[interface]

# The language the interface starts in: "system" for the machine's language,
# or the code of a translation compiled into the application ("en", "es"; the
# View menu lists them). Choosing a language in the View menu writes it here,
# into the settings file in use, so the next start comes up in it.
# Values: "system" or a language code.
# language = system


# ---------------------------------------------------------------------------
# [limits] - ceilings that exist to stop a typo, not to express a limit of the
# method. Every one of these only ever REFUSES input, so moving them changes
# no computed result. They are the safest thing in this file.
# ---------------------------------------------------------------------------
[limits]

# Cells of the Nichols grid for the boundaries: phase points x magnitude
# points. For scale, a one-degree grid over 360 degrees is 361 points per
# axis, so 130321 cells. The default is far past anything sensible, and it is
# here because two extra zeros in a dialog used to reach an allocation of that
# many doubles and take the application down.
# Range: 4 to 1e15.
# max-grid-cells = 10000000

# Points per parameter grid in the template sweep. The count comes from an
# expression you type, so it can be anything the parser accepts - a negative
# one used to ask for 1.8e19 doubles.
# Range: 1 to 1e12.
# max-template-points = 1000000

# Design frequencies in one set.
# Range: 1 to 2147483647.
# max-frequency-count = 1000000

# Largest magnitude accepted in the loop-shaping dialog's fields, which is
# what keeps an infinity out of an integer conversion.
# Range: 1 to 1e300.
# max-magnitude = 1e12


# ---------------------------------------------------------------------------
# [search] - what the interval search is allowed to spend.
# ---------------------------------------------------------------------------
[search]

# Live nodes the branch & bound list may hold before it refuses to grow.
# It is a MEMORY budget, not a time one: a node measures 528 bytes with two
# uncertain parameters and 1056 with eight, so the default is of the order of
# 17 to 34 GB.
#
# How to set it from your own runs: every loop-shaping run prints "peak live
# nodes" next to its elapsed time. The peaks of the long benchmarks are the
# number to size this from - the small fixtures all resolve early, with peaks
# between 1 and 281 nodes whatever the epsilon, so they say nothing useful
# about it.
# Range: 1 to 1e15.
# max-live-nodes = 32000000


# ---------------------------------------------------------------------------
# [defaults.*] - what the dialogs start with.
#
# The zero-risk group: these are what a field is PREFILLED with, so nothing
# here can change a computed result - you see the value and can type over it.
# It is also the group that shows most in daily use: if you always work with
# the same Nichols grid, this is where you stop typing it.
# ---------------------------------------------------------------------------

# The Nichols grid of the boundary computation. Phase in degrees, magnitude
# in decibels, and the number of points on each axis.
#
# The phase axis has to span at least 360 degrees or the boundary union
# cannot close, which the computation checks for itself and refuses. The
# default 361 points over -360..0 is the classic one-degree grid.
# Ranges: the ends -3600 to 3600 (phase) and -1000 to 1000 (magnitude);
# the point counts 2 to 1e6.
[defaults.boundary-grid]
# phase-start = -360
# phase-end = 0
# phase-points = 361
# magnitude-start = -60
# magnitude-end = 60
# magnitude-points = 121

# Points per parameter grid in the template sweep. With ten points the
# largest gap in a template can reach a fifth of its size, and the contour
# then follows the sweep rather than the template; twenty-five keeps it
# under a few per cent. Remember this multiplies: with n uncertain
# parameters the sweep evaluates this many to the power of n plants, so 25
# with five parameters is already 1e7 and with eight it is out of reach.
# Range: 1 to 1e6.
[defaults.templates]
# point-count = 25

# The plane a NEW project measures its contour epsilon in. 1, the Nichols
# plane: distances in degrees and decibels, one decibel weighing as much as
# db-per-degree degrees; there one epsilon serves every template of a
# project. 0, the complex plane: the historical reading, a distance in the
# units of the plant's response, which on the toolbox example 2 needs an
# epsilon ten thousand times smaller at 100 rad/s than at 0.1. A loaded
# project keeps the plane its file says.
# Range: 0 or 1.
# epsilon-in-nichols = 1

# How many decibels weigh as much as one degree in the Nichols plane.
# Range: 1e-6 to 1e6.
# db-per-degree = 1

# The frequency range the loop-shaping plot starts with, in rad/s, and how
# many points over it.
#
# ONE range, used on opening and on picking either mode. The dialog carried
# three hardcoded sets before - one per place - and the two mode ones differed
# from each other and from the opening one with no reason recorded anywhere;
# worse, picking a mode overwrote whatever the fields held, so a configured
# default would have been thrown away.
# Ranges: the ends 1e-300 to 1e300, the point count 2 to 1e6.
[defaults.loop-shaping]
# start = 1e-09
# end = 10
# point-count = 100


# ---------------------------------------------------------------------------
# [stability] - the resolution of the nominal stability check.
#
# These trade TIME against how reliably the check decides, and they do not
# touch the criterion: the Cohen-Chait-Yaniv crossing count and its 0 dB ray
# are the method, not settings.
#
# What they govern is the frequency grid the nominal loop is sampled on before
# the crossings are counted. Too coarse and a fast phase turn is missed, the
# checker answers "cannot decide", and a candidate that may have been perfectly
# good is discarded - conservatively, but discarded. Too fine and every
# candidate costs more, which in a search of millions of candidates is the
# whole run.
# ---------------------------------------------------------------------------
[stability]

# Points of the base logarithmic grid.
# Range: 10 to 1e7.
# base-grid-points = 3000

# Decades sampled beyond the design frequencies, on both sides.
# Range: 0 to 20.
# decades-beyond = 3

# Phase step, in degrees, above which the grid is refined. It is the
# unwrapping tolerance: a turn faster than this between two samples cannot be
# unwrapped safely, so the interval between them is split.
# Range: 0.1 to 180.
# max-phase-step-degrees = 30

# Refinements one verdict may spend before giving up and answering "cannot
# decide".
# Range: 1 to 1e9.
# refinement-budget = 200000


# ---------------------------------------------------------------------------
# [algorithms] - figures from the published algorithms.
#
# THE GROUP TO BE CAREFUL WITH, and the only one where that is true. Unlike
# everything above, these change WHAT THE ALGORITHM COMPUTES - not how long it
# takes to compute it. Every one is a number from a paper, and the provenance
# is written next to it, because a value changed here makes the golden tests
# and the article validations stop describing the program that is running.
#
# They are here anyway, deliberately: a doctoral toolbox whose published
# parameters can only be explored by recompiling is a worse tool. What makes
# it safe is that no test reads this file - the test suite builds its own
# settings, and only the application itself ever loads one - so a value here
# can never change what a test means.
# ---------------------------------------------------------------------------
[algorithms]

# MR (Rambabu & Nataraj, FDA-10): template points entering the constraint set
# per design frequency, paired quadratically for the tracking constraint. The
# paper uses 9.
#
# KNOWN LIMIT, measured on the article's Example 5.1 over a 51x51 sweep of the
# uncertainty: the design MR certifies exceeds the true tracking bound by 12
# to 19 per cent at two of the five design frequencies. Raising this to 25
# shrinks the excess from 0.456 to 0.431 dB at twelve times the cost, without
# removing it. The way out is to BOUND the spread of |T| by intervals over the
# template instead of sampling it, which would remove the gap entirely - and
# that is a modelling decision for the thesis, not a setting.
# Range: 2 to 1000.
# template-representatives = 9

# MR: passes of the HC4 narrowing before a box is accepted as narrowed no
# further.
# Range: 1 to 1000.
# max-narrowing-passes = 8

# MR: what the termination epsilon measures. 0, the paper's criterion: the
# width of the CONTROLLER PARAMETER box. 1, the criterion of the other four
# algorithms: the diameter of the NICHOLS box of the leading node, in dB and
# degrees. The two numbers are not comparable (see docs/algorithms), so
# with 0 the running time of MR cannot be set against the others'; with 1
# the five algorithms stop on the same measure. Needs a zero-pole-gain
# controller structure, as the other four do.
# Range: 0 or 1.
# mr-nichols-epsilon = 0

# NT, NK, MC1, MC (thesis), MC2: how a phase is read off the boundary
# columns. 0, the published reading: the column whose node is NEAREST the
# phase. 1, the conservative reading: BOTH columns whose nodes bracket the
# phase, so a point or a box must be allowed by the two. The nearest node
# admits, up to half a grid step away, what the boundary at the point's own
# phase forbids - 0.05 dB on the toolbox example 2 with a 1-degree grid - and
# 1 removes that; but the strip cuts of the searches need every column of a
# span to agree, and how often the two columns agree depends on the grid:
# with 1 degree NT, NK and MC1 take about a thousand times longer on that
# example, with 0.25 degrees a few seconds, with 0.125 degrees under a
# second, less than the boundaries cost. For a certified result use 1 with a
# fine phase grid (see docs/CONFIGURATION.md). The returned controller is
# checked against the specifications either way (see the loop-shaping result).
# Range: 0 or 1.
# conservative-boundary-columns = 0

# Templates: what to do when the contour walk does not close at a design
# frequency with the epsilon given. 1: the WHOLE template stands in for its
# contour there, which is always safe (the boundaries read every point) and
# only slower, and the viewer marks the frequency. 0: stop with an error
# naming the frequency, for the user to change the epsilon or the sweep.
# The templates dialog offers the same choice per computation.
# Range: 0 or 1.
# whole-template-if-no-contour = 1

# Templates: how the contour of a template is extracted. 0, the walk of
# Nordin (the historical epsilon-hull, the published algorithm), which can
# fail to close and then falls back as the setting above says. 1, the
# alpha-shape: the same boundary by its definition, edge by edge - an edge is
# on the contour when a disc of diameter epsilon through its ends holds no
# other point - which always closes and returns every component and hole.
# The proposed epsilon is then the least that keeps the template connected.
# Range: 0 or 1.
# alpha-shape-contour = 0

# Templates: with exactly TWO uncertain parameters, 1 sweeps only the border
# of the parameter box - as many evaluations as the interior grid would have
# cost, spent on the four edges, each along the user's own grid - because
# the worst case of every specification over a template lies on its border
# (the closed-loop magnitudes are Mobius functions of the plant). The
# template is then a closed curve, its contour is taken by the alpha-shape,
# and the gap between neighbouring points shrinks by the grid size. With one
# or with three or more uncertain parameters the interior is swept as usual.
# Range: 0 or 1.
# border-sweep = 0

# NK (Nataraj & Kubal 2007): iterations the local refinement of a candidate
# point may spend.
# Range: 1 to 1e7.
# local-search-budget = 400

# NK: the ratio at which the gain bisection stops, so 1.01 is one per cent.
# It is a PRUNING bound and not the accuracy of the answer.
# Range: strictly above 1, up to 10. Exactly 1 would be a bisection that never
# ends, which is a hang rather than a tighter result, so it is refused.
# gain-tolerance = 1.01

# MC1 (Martinez-Forte & Cervera, IJRNC 2021): the same ratio for the certified
# gain search.
# Range: strictly above 1, up to 10.
# certified-gain-tolerance = 1.01
